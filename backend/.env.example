# Copy to .env and fill in real values before running.

# PostgreSQL connection string. Locally: postgresql://user:password@localhost:5432/pfms
# On Railway/Render/Supabase: copy the connection string they generate for you.
DATABASE_URL="postgresql://pfms:pfms_dev_pw@localhost:5432/pfms?schema=public"

# Generate with: openssl rand -hex 32 — never share this or commit a real value.
JWT_SECRET="change_me_generate_a_real_random_secret"

# Encrypts borrower national ID / address / phone number at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32 — REQUIRED before deploying with real
# borrower data (the app refuses to start without it when NODE_ENV=production).
# Losing this key makes existing encrypted PII unrecoverable — back it up
# somewhere safe, separate from the database backup.
PII_ENCRYPTION_KEY=

PORT=3001

# NODE_ENV=production enables production-only safety checks (e.g. requires
# PII_ENCRYPTION_KEY to be set). Leave unset for local development.
# NODE_ENV=production

# Which SMS provider RemindersModule uses: CONSOLE (default, safe no-op stub),
# AFRICAS_TALKING, or TWILIO. Leave as CONSOLE until the chosen provider's
# credentials below are set and tested — see docs/DEPLOYMENT_GUIDE.md.
SMS_PROVIDER=CONSOLE

# Optional — only needed if SMS_PROVIDER=AFRICAS_TALKING (see docs/DEPLOYMENT_GUIDE.md).
# AT_API_KEY=
# AT_USERNAME=

# Optional — only needed if SMS_PROVIDER=TWILIO (see docs/DEPLOYMENT_GUIDE.md).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
